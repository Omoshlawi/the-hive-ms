// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../dist/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Core appointment model
model Appointment {
  id          String  @id @default(uuid()) @db.Uuid
  title       String
  description String?

  // Scheduling details
  startTime DateTime
  endTime   DateTime
  timezone  String   @default("UTC")
  duration  Int // Duration in minutes

  // Status and workflow
  status   AppointmentStatus @default(SCHEDULED)
  priority Priority          @default(MEDIUM)

  // Relationships
  appointmentTypeId String          @db.Uuid
  appointmentType   AppointmentType @relation(fields: [appointmentTypeId], references: [id])

  organizerId    String @db.Uuid // User id of the organizaer
  organizer      Json? // Minimal essential user  details cache from user-service
  organizationId String
  organization   Json? // Minimal organization details

  // Participants (many-to-many)
  participants AppointmentParticipant[]

  // Flexible metadata for type-specific data
  metadata Json?

  // Resources (properties, rooms, equipment)
  resources AppointmentResource[] // MVP Resources

  // TODO future enhancements
  // Location details
  // location AppointmentLocation?

  // TODO Move to notifications service
  // Notifications and reminders
  // notifications AppointmentNotification[]

  // Audit fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String

  // Recurring appointments
  recurrenceRule String? // RRULE format
  parentId       String?       @db.Uuid // For recurring series
  parent         Appointment?  @relation("RecurringAppointments", fields: [parentId], references: [id])
  children       Appointment[] @relation("RecurringAppointments")

  // Cancellation/Rescheduling
  cancelledAt        DateTime?
  cancellationReason String?
  rescheduledFrom    String? // Previous appointment ID

  @@index([startTime, endTime])
  @@index([organizerId])
  @@index([status])
  @@index([appointmentTypeId])
  @@map("appointments")
}

// Appointment types for different real estate activities
model AppointmentType {
  id          String              @id @default(uuid()) @db.Uuid
  name        String              @unique
  description String?
  category    AppointmentCategory

  // Default settings
  defaultDuration    Int // Minutes
  bufferTimeBefore   Int? // Minutes
  bufferTimeAfter    Int? // Minutes
  allowOnlineBooking Boolean @default(true)
  requiresApproval   Boolean @default(false)
  maxParticipants    Int?

  // Availability settings
  availabilityRules Json? // Flexible rules for when this type can be booked

  // Required fields configuration
  requiredFields Json? // Define what fields are required for this type

  // Pricing (if applicable)
  baseCost Decimal? @db.Decimal(10, 2)

  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("appointment_types")
}

// Participants in appointments (many-to-many with metadata)
model AppointmentParticipant {
  id            String      @id @default(uuid()) @db.Uuid
  appointmentId String      @db.Uuid
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  userId String @db.Uuid
  user   Json?

  role       ParticipantRole   @default(ATTENDEE)
  status     ParticipantStatus @default(PENDING)
  isRequired Boolean           @default(true)

  // Response tracking
  respondedAt DateTime?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([appointmentId, userId])
  @@map("appointment_participants")
}

model AppointmentResource {
  id            String      @id @default(uuid()) @db.Uuid
  appointmentId String      @db.Uuid
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  resourceId    String      @db.Uuid
  resource      Json?
  resourceModel String
  //   // Resource-specific notes or requirements
  notes         String?

  //   @@unique([appointmentId, resourceId])
  @@map("appointment_resources")
}

