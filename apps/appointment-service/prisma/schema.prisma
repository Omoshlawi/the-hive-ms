// Availability slots for users
model AvailabilitySlot {
  id     String @id @default(uuid()) @db.Uuid
  label  String // For describing the slot (e.g., "Morning tours")
  userId String @db.Uuid
  user   Json?

  // Time range
  startTime DateTime
  endTime   DateTime

  // Recurrence pattern
  recurrenceRule String? // RRULE format

  voided    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, startTime, endTime])
  @@map("availability_slots")
}

// Enums
enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum AppointmentCategory {
  PROPERTY_VIEWING // Tours, showings
  INSPECTION // Property inspections, appraisals
  CONSULTATION // Client meetings, investment consultations
  TRANSACTION // Closings, signings
  MAINTENANCE // Repairs, cleaning, landscaping
  TENANT_MANAGEMENT // Lease signings, move-ins/outs
  PHOTOGRAPHY // Property photography, virtual tours
  LEGAL // Legal consultations, document reviews
  OTHER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ParticipantRole {
  ORGANIZER
  ATTENDEE
  OPTIONAL
  RESOURCE_PERSON
}

enum ParticipantStatus {
  PENDING
  ACCEPTED
  DECLINED
  TENTATIVE
}

