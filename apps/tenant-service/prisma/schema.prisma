// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../dist/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Main Tenant model extending Person from another service
model Tenant {
  id                       String            @id @default(uuid()) @db.Uuid
  personId                 String            @db.Uuid // Reference to Person in Person Service
  person                   Json?
  // Tenant-specific fields
  tenantNumber             String            @unique // Internal tenant reference number
  tenantType               TenantType        @default(INDIVIDUAL)
  status                   TenantStatus      @default(ACTIVE)
  creditScore              Int?
  monthlyIncome            Decimal?          @db.Decimal(12, 2)
  employmentStatus         EmploymentStatus?
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactEmail    String?
  emergencyContactRelation String?

  // Preferences and requirements
  preferredContactMethod ContactMethod @default(EMAIL)
  languagePreference     String?       @default("en")
  specialRequirements    String? // Accessibility, pet accommodations, etc.

  // Rental history and references
  rentalApplications RentalApplication[]

  // Tenant status history for audit trail
  statusHistory TenantStatusHistory[]

  // Tenant documents
  documents TenantDocument[]

  // Notes and internal tracking
  internalNotes String?
  tags          String[] // For categorization and filtering

  // Audit fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid

  coApplicants            CoApplicant[]
  agreementParticipations AgreementParticipant[]

  @@index([personId])
  @@index([tenantNumber])
  @@index([status])
  @@index([createdAt])
}

// Tenant status history for audit trail
model TenantStatusHistory {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  previousStatus TenantStatus
  newStatus      TenantStatus
  changedBy      String?      @db.Uuid
  reason         String?      @db.Text
  createdAt      DateTime     @default(now())
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// References (personal/professional)
model TenantReference {
  id            String @id @default(uuid()) @db.Uuid
  applicationId String @db.Uuid

  referenceType ReferenceType
  name          String
  relationship  String
  phoneNumber   String?
  email         String?
  company       String?
  position      String?

  // Verification status
  contacted      Boolean                  @default(false)
  contactedDate  DateTime?
  response       String? // Notes from reference check
  recommendation ReferenceRecommendation?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application RentalApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

// Rental applications
model RentalApplication {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  tenantId       String @db.Uuid
  propertyId     String @db.Uuid // Reference to Property Service (physical real estate unit)
  listingId      String @db.Uuid // Reference to Listing Service (marketing listing)

  applicationNumber String            @unique
  status            ApplicationStatus @default(PENDING)

  // Application details
  desiredMoveInDate DateTime
  leaseTerm         Int? // in months
  proposedRent      Decimal? @db.Decimal(10, 2)
  securityDeposit   Decimal? @db.Decimal(10, 2)
  petDetails        String? // Pet information if applicable
  vehicleInfo       String? // Vehicle details for parking

  // Co-applicants and screening responses
  coApplicants       CoApplicant[]
  screeningResponses ScreeningResponse[]

  // Application status history for audit trail
  statusHistory RentalApplicationStatusHistory[]

  // Screening and evaluation
  screeningScore     Decimal? @db.Decimal(5, 2) // Calculated screening score
  manualReviewNeeded Boolean  @default(false)

  // Internal processing
  assignedToUser String? @db.Uuid
  internalNotes  String?

  // Background check and verification
  backgroundCheckStatus BackgroundCheckStatus?
  backgroundCheckDate   DateTime?
  identityVerified      Boolean                @default(false)
  incomeVerified        Boolean                @default(false)

  // Background check status history for audit trail
  backgroundCheckStatusHistory BackgroundCheckStatusHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  references TenantReference[]

  @@index([organizationId])
  @@index([tenantId])
  @@index([propertyId])
  @@index([listingId])
  @@index([status])
}

// Rental application status history
model RentalApplicationStatusHistory {
  id            String            @id @default(uuid()) @db.Uuid
  applicationId String            @db.Uuid
  application   RentalApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  previousStatus ApplicationStatus
  newStatus      ApplicationStatus
  changedBy      String?           @db.Uuid
  reason         String?           @db.Text
  createdAt      DateTime          @default(now())

  @@index([applicationId])
}

// Co-applicants for rental applications
model CoApplicant {
  id            String @id @default(uuid()) @db.Uuid
  applicationId String @db.Uuid
  tenantId      String @db.Uuid // Optional link to an existing tenant

  // Relationship to primary applicant
  relationshipType String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application RentalApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  tenant      Tenant            @relation(fields: [tenantId], references: [id])

  @@index([applicationId])
}

// Base Agreement model - Flexible for any type of rental agreement
model RentalAgreement {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  propertyId     String @db.Uuid

  // Agreement identification
  agreementNumber String          @unique @db.VarChar(50)
  agreementType   AgreementType // LEASE, RENTAL, SHORT_TERM, etc.
  status          AgreementStatus @default(ACTIVE)

  // Basic periods - flexible for all agreement types
  startDate DateTime  @db.Date
  endDate   DateTime? @db.Date

  // Core financial terms - common to all agreements
  baseRentAmount Decimal @db.Decimal(10, 2) // Could be monthly rent, total amount, etc.

  // Flexible metadata for type-specific fields
  // This JSON field allows each agreement type to store specific data
  typeSpecificData Json? // Store agreement-type specific fields here

  // Common terms
  noticePeriodDays  Int     @default(30)
  autoRenewal       Boolean @default(false)
  petsAllowed       Boolean @default(false)
  smokingAllowed    Boolean @default(false)
  sublettingAllowed Boolean @default(false)

  // TODO add model to flexibly handle terminations
  // Termination details
  // terminationReason     String?   @db.VarChar(200)
  // terminationNoticeDate DateTime? @db.Date
  // earlyTerminationFee   Decimal?  @db.Decimal(10, 2)

  // Audit fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid
  metadata  Json? // General metadata

  // Relations
  participants      AgreementParticipant[]
  additionalCharges AdditionalCharge[]

  // Type-specific extensions
  leaseDetails     LeaseAgreementDetails?
  rentalDetails    RentalAgreementDetails?
  shortTermDetails ShortTermAgreementDetails?
  statusHistory    AgreementStatusHistory?

  @@index([organizationId])
  @@index([propertyId])
  @@index([status])
  @@index([agreementType])
  @@index([startDate, endDate])
}

model AgreementStatusHistory {
  id             String          @id @default(uuid()) @db.Uuid
  agreementId    String          @unique @db.Uuid
  agreement      RentalAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  previousStatus AgreementStatus
  newStatus      AgreementStatus
  changedBy      String?         @db.Uuid
  reason         String?         @db.Text
  createdAt      DateTime        @default(now())
}

// Extension for Traditional Lease agreements (long-term, typically 12+ months)
model LeaseAgreementDetails {
  id          String          @id @default(uuid()) @db.Uuid
  agreementId String          @unique @db.Uuid
  agreement   RentalAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  // Lease-specific fields
  leaseTerm        Int     @default(12) // in months
  renewalOptions   Json? // Renewal terms and options
  rentEscalation   Json? // Rent increase schedules
  maintenanceTerms String? @db.Text

  // Lease-specific compliance
  leaseCompliance Json? // Legal compliance requirements

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Extension for Rental agreements (month-to-month, flexible terms)
model RentalAgreementDetails {
  id          String          @id @default(uuid()) @db.Uuid
  agreementId String          @unique @db.Uuid
  agreement   RentalAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  // Rental-specific fields
  billingCycle  BillingCycle @default(MONTHLY)
  flexibleTerms Boolean      @default(true)
  minimumStay   Int? // in days/months

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Extension for Short-term agreements (Airbnb-style, vacation rentals)
model ShortTermAgreementDetails {
  id          String          @id @default(uuid()) @db.Uuid
  agreementId String          @unique @db.Uuid
  agreement   RentalAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  // Short-term specific fields
  checkInTime     String? // "3:00 PM"
  checkOutTime    String? // "11:00 AM"
  cleaningFee     Decimal? @db.Decimal(10, 2)
  guestCapacity   Int?
  houseRules      String?  @db.Text
  amenities       String[] // List of amenities
  bookingPlatform String? // Airbnb, Booking.com, etc.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Flexible participant model
model AgreementParticipant {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  agreementId    String @db.Uuid
  tenantId       String @db.Uuid

  participantType          ParticipantType
  responsibilityPercentage Decimal?        @db.Decimal(5, 2)
  isPrimaryTenant          Boolean         @default(false)

  status        ParticipantStatus          @default(ACTIVE)
  statusHistory ParticipantStatusHistory[]

  // Flexible move dates
  moveInDate  DateTime?
  moveOutDate DateTime?

  // Participant-specific terms (stored as JSON for flexibility)
  participantTerms Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  metadata  Json?

  // Relations
  agreement RentalAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([agreementId])
  @@index([tenantId])
}

// Participant status history
model ParticipantStatusHistory {
  id            String @id @default(uuid()) @db.Uuid
  participantId String @db.Uuid

  previousStatus ParticipantStatus
  newStatus      ParticipantStatus
  changedBy      String?
  reason         String?              @db.Text
  createdAt      DateTime             @default(now())
  participant    AgreementParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([participantId])
}

// Document management for tenants
model TenantDocument {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  tenantId       String @db.Uuid

  documentType DocumentType
  documentUrl  String
  metadata     Json?

  // Document metadata
  title       String?
  description String?
  isRequired  Boolean   @default(false)
  isVerified  Boolean   @default(false)
  verifiedAt  DateTime?
  verifiedBy  String?   @db.Uuid

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  uploadedBy String?  @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([tenantId])
  @@index([documentType])
}

// Background check status history
model BackgroundCheckStatusHistory {
  id             String                @id @default(uuid()) @db.Uuid
  applicationId  String                @db.Uuid
  previousStatus BackgroundCheckStatus
  newStatus      BackgroundCheckStatus
  changedBy      String?
  reason         String?               @db.Text
  createdAt      DateTime              @default(now())

  application RentalApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

// Flexible screening questions and responses system
model ScreeningQuestion {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid

  // Question definition
  question     String
  questionType QuestionType
  isRequired   Boolean      @default(true)
  isActive     Boolean      @default(true)
  sortOrder    Int          @default(0)

  // Question configuration
  options     String[] // For multiple choice, dropdown, checkbox
  placeholder String? // For text inputs
  helpText    String? // Additional guidance for applicants

  // Validation rules
  minLength Int?
  maxLength Int?
  minValue  Decimal? @db.Decimal(12, 2)
  maxValue  Decimal? @db.Decimal(12, 2)
  pattern   String? // Regex pattern for validation

  // Categorization
  category QuestionCategory @default(GENERAL)
  tags     String[] // For filtering and grouping

  // Scoring (for automated screening)
  hasScoring   Boolean @default(false)
  scoringRules Json? // JSON object with scoring logic

  // Usage tracking
  usageCount Int @default(0)

  // Responses to this question
  responses ScreeningResponse[]

  // Audit fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid

  @@index([organizationId])
  @@index([category])
  @@index([isActive])
  @@index([sortOrder])
}

// Screening responses from applicants
model ScreeningResponse {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  applicationId  String @db.Uuid
  questionId     String @db.Uuid

  // Response data
  textResponse    String?
  numericResponse Decimal?  @db.Decimal(12, 2)
  booleanResponse Boolean?
  dateResponse    DateTime?
  jsonResponse    Json? // For complex responses

  // Scoring and evaluation
  calculatedScore Decimal? @db.Decimal(5, 2)
  flagged         Boolean  @default(false)
  flagReason      String?

  // Verification
  requiresVerification Boolean   @default(false)
  verified             Boolean   @default(false)
  verifiedAt           DateTime?
  verifiedBy           String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application RentalApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  question    ScreeningQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([applicationId, questionId])
  @@index([organizationId])
  @@index([applicationId])
  @@index([questionId])
  @@index([flagged])
}

// Pre-defined screening question templates for quick setup
model ScreeningQuestionTemplate {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String? @db.Uuid // null for system-wide templates

  name             String
  description      String?
  category         QuestionCategory
  isSystemTemplate Boolean          @default(false) // System vs custom templates

  // Template configuration
  questions Json // Array of question configurations

  // Usage tracking
  usageCount Int      @default(0) // How many times this template has been applied to listings
  rating     Decimal? @db.Decimal(3, 2) // User rating 1-5

  // Audit fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.Uuid

  @@index([organizationId])
  @@index([category])
  @@index([isSystemTemplate])
}

// Property listing screening configuration
model PropertyScreeningConfig {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  listingId      String @db.Uuid // Reference to Listing Service

  // Screening settings
  isScreeningEnabled   Boolean @default(true)
  autoScreenEnabled    Boolean @default(false)
  manualReviewRequired Boolean @default(true)

  // Scoring configuration
  passingScore     Decimal? @db.Decimal(5, 2)
  weightByCategory Json? // Category-based scoring weights

  // Question assignments
  questionIds String[] @db.Uuid // Array of screening question IDs

  // Customization per listing
  customInstructions     String?
  additionalRequirements String?

  // Notification settings
  notifyOnApplication Boolean  @default(true)
  notifyOnAutoReject  Boolean  @default(true)
  notificationEmails  String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid

  @@unique([listingId])
  @@index([organizationId])
  @@index([listingId])
}

// Flexible additional charges model
model AdditionalCharge {
  id          String          @id @default(uuid()) @db.Uuid
  agreementId String          @db.Uuid
  agreement   RentalAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  name        String // e.g., "Cleaning Fee", "Pet Fee", "Parking"
  description String?
  amount      Decimal         @db.Decimal(12, 2)
  frequency   ChargeFrequency @default(ONE_TIME)
  mandatory   Boolean         @default(true)

  // Charge-specific metadata
  chargeMetadata Json?
  voided         Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agreementId])
}

// ENUMS

enum AgreementType {
  LEASE // Traditional long-term lease (12+ months)
  RENTAL // Month-to-month or flexible rental
  SHORT_TERM // Vacation rental, Airbnb-style
  CORPORATE // Corporate housing
  SUBLEASE // Subletting arrangement
  COMMERCIAL // Commercial property lease
  RENT_TO_OWN // Rent-to-own agreements
  STUDENT // Student housing
  SENIOR // Senior living agreements
}

enum BillingCycle {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUALLY
}

enum ChargeFrequency {
  ONE_TIME
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUALLY
  PER_NIGHT
  PER_STAY
}

enum ParticipantType {
  PRIMARY_TENANT
  CO_TENANT
  GUARANTOR
  OCCUPANT
  SUBLESSEE
  AUTHORIZED_OCCUPANT
}

enum AgreementStatus {
  DRAFT
  PENDING
  ACTIVE
  EXPIRED
  TERMINATED
  RENEWED
  CANCELLED
  SUSPENDED
}

enum ParticipantStatus {
  ACTIVE
  TERMINATED
  EXPIRED
  PENDING
  SUSPENDED
}

enum TenantType {
  INDIVIDUAL
  COUPLE
  FAMILY
  ROOMMATES
  CORPORATE
  STUDENT
}

enum TenantStatus {
  ACTIVE
  INACTIVE
  BLACKLISTED
  PROSPECTIVE
}

enum EmploymentStatus {
  EMPLOYED_FULL_TIME
  EMPLOYED_PART_TIME
  SELF_EMPLOYED
  UNEMPLOYED
  RETIRED
  STUDENT
  CONTRACTOR
}

enum ContactMethod {
  EMAIL
  PHONE
  SMS
  MAIL
  IN_PERSON
}

enum BackgroundCheckStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  NOT_REQUIRED
  IN_PROGRESS
}

enum ReferenceType {
  PERSONAL
  PROFESSIONAL
  PREVIOUS_LANDLORD
  EMPLOYER
  CHARACTER
  EMERGENCY_CONTACT
}

enum ReferenceRecommendation {
  HIGHLY_RECOMMENDED
  RECOMMENDED
  NEUTRAL
  NOT_RECOMMENDED
  STRONGLY_NOT_RECOMMENDED
}

enum ApplicationStatus {
  DRAFT
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  WITHDRAWN
  EXPIRED
  CONDITIONAL_APPROVAL
}

enum DocumentType {
  ID_DOCUMENT
  INCOME_VERIFICATION
  EMPLOYMENT_LETTER
  BANK_STATEMENT
  REFERENCE_LETTER
  BACKGROUND_CHECK
  CREDIT_REPORT
  INSURANCE_CERTIFICATE
  PET_DOCUMENTATION
  LEASE_AGREEMENT
  RENTAL_HISTORY
  TAX_RETURN
  PROOF_OF_FUNDS
  OTHER
}

enum QuestionCategory {
  GENERAL
  PERSONAL_INFO
  EMPLOYMENT
  INCOME
  RENTAL_HISTORY
  REFERENCES
  PETS
  VEHICLES
  BACKGROUND
  PREFERENCES
  EMERGENCY_CONTACT
  FAMILY
  FINANCIAL
  LEGAL
  CUSTOM
}

enum QuestionType {
  TEXT
  TEXTAREA
  NUMBER
  BOOLEAN
  DATE
  EMAIL
  PHONE
  SINGLE_SELECT
  MULTI_SELECT
  CHECKBOX
  DROPDOWN
  FILE_UPLOAD
  CURRENCY
  PERCENTAGE
  URL
  TIME
  DATETIME
  RATING
  SLIDER
  SIGNATURE
}
