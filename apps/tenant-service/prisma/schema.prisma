// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../dist/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Main Tenant model extending Person from another service
model Tenant {
  id                       String            @id @default(uuid()) @db.Uuid
  personId                 String            @db.Uuid // Reference to Person in Person Service
  person                   Json?
  // Tenant-specific fields
  tenantNumber             String?           @unique // Internal tenant reference number
  tenantType               TenantType        @default(INDIVIDUAL)
  status                   TenantStatus      @default(ACTIVE)
  creditScore              Int?
  monthlyIncome            Decimal?          @db.Decimal(12, 2)
  employmentStatus         EmploymentStatus?
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactEmail    String?
  emergencyContactRelation String?

  // Preferences and requirements
  preferredContactMethod ContactMethod @default(EMAIL)
  languagePreference     String?       @default("en")
  specialRequirements    String? // Accessibility, pet accommodations, etc.

  // Rental history and references
  previousAddresses  TenantAddress[]
  references         TenantReference[]
  rentalApplications RentalApplication[]
  leases             TenantLease[]

  // Tenant status history for audit trail
  statusHistory TenantStatusHistory[]

  // Background check and verification
  backgroundCheckStatus BackgroundCheckStatus?
  backgroundCheckDate   DateTime?
  identityVerified      Boolean                @default(false)
  incomeVerified        Boolean                @default(false)

  // Tenant documents
  documents TenantDocument[]

  // Background check status history for audit trail
  backgroundCheckStatusHistory BackgroundCheckStatusHistory[]

  // Notes and internal tracking
  internalNotes String?
  tags          String[] // For categorization and filtering

  // Audit fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid
  // @@map("tenants")

  @@index([personId])
  @@index([tenantNumber])
  @@index([status])
  @@index([createdAt])
}

// Tenant status history for audit trail
model TenantStatusHistory {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  previousStatus TenantStatus
  newStatus      TenantStatus
  changedBy      String?
  reason         String?      @db.Text
  createdAt      DateTime     @default(now())
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// Previous addresses for rental history
model TenantAddress {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  tenantId       String @db.Uuid

  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  postalCode   String
  country      String  @default("US")

  // Rental period
  moveInDate  DateTime
  moveOutDate DateTime?

  // Landlord information
  landlordName     String?
  landlordPhone    String?
  landlordEmail    String?
  monthlyRent      Decimal? @db.Decimal(10, 2)
  reasonForLeaving String?

  // Verification
  verified          Boolean   @default(false)
  verifiedDate      DateTime?
  verificationNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // @@map("tenant_addresses")

  @@index([organizationId])
  @@index([tenantId])
}

// References (personal/professional)
model TenantReference {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  referenceType ReferenceType
  name          String
  relationship  String
  phoneNumber   String?
  email         String?
  company       String?
  position      String?

  // Verification status
  contacted      Boolean                  @default(false)
  contactedDate  DateTime?
  response       String? // Notes from reference check
  recommendation ReferenceRecommendation?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // @@map("tenant_references")

  @@index([tenantId])
}

// Rental applications
model RentalApplication {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  tenantId       String @db.Uuid
  propertyId     String @db.Uuid // Reference to Property Service (physical real estate unit)
  listingId      String @db.Uuid // Reference to Listing Service (marketing listing)

  applicationNumber String            @unique
  status            ApplicationStatus @default(PENDING)

  // Application details
  desiredMoveInDate DateTime
  leaseTerm         Int? // in months
  proposedRent      Decimal? @db.Decimal(10, 2)
  securityDeposit   Decimal? @db.Decimal(10, 2)
  petDetails        String? // Pet information if applicable
  vehicleInfo       String? // Vehicle details for parking

  // Co-applicants and screening responses
  coApplicants       CoApplicant[]
  screeningResponses ScreeningResponse[]

  // Application status history for audit trail
  statusHistory RentalApplicationStatusHistory[]

  // Screening and evaluation
  screeningScore     Decimal? @db.Decimal(5, 2) // Calculated screening score
  // autoScreenResult   AutoScreenResult?
  manualReviewNeeded Boolean  @default(false)

  // Internal processing
  assignedToUser String? @db.Uuid
  internalNotes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // @@map("rental_applications")

  @@index([organizationId])
  @@index([tenantId])
  @@index([propertyId])
  @@index([listingId])
  @@index([status])
}

// Rental application status history
model RentalApplicationStatusHistory {
  id            String            @id @default(uuid()) @db.Uuid
  applicationId String            @db.Uuid
  application   RentalApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  previousStatus ApplicationStatus
  newStatus      ApplicationStatus
  changedBy      String?
  reason         String?           @db.Text
  createdAt      DateTime          @default(now())

  @@index([applicationId])
}

// Co-applicants for rental applications
model CoApplicant {
  id            String @id @default(uuid()) @db.Uuid
  applicationId String @db.Uuid

  // Personal information
  firstName   String
  lastName    String
  email       String?
  phoneNumber String?
  dateOfBirth DateTime?
  ssn         String? // Encrypted

  // Employment
  employmentStatus EmploymentStatus?
  employer         String?
  jobTitle         String?
  monthlyIncome    Decimal?          @db.Decimal(10, 2)

  // Relationship to primary applicant
  relationshipType String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application RentalApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  // @@map("co_applicants")

  @@index([applicationId])
}

// Tenant lease relationships (references to Lease Service)
model TenantLease {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  tenantId       String @db.Uuid
  leaseId        String @db.Uuid // Reference to Lease Service

  // Tenant's role in the lease
  isPrimaryTenant Boolean           @default(true)
  moveInDate      DateTime?
  moveOutDate     DateTime?
  status          TenantLeaseStatus @default(ACTIVE)

  // Tenant lease status history for audit trail
  statusHistory TenantLeaseStatusHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // @@map("tenant_leases")

  @@unique([tenantId, leaseId])
  @@index([organizationId])
  @@index([tenantId])
  @@index([leaseId])
}

// Tenant lease status history
model TenantLeaseStatusHistory {
  id            String @id @default(uuid()) @db.Uuid
  tenantLeaseId String @db.Uuid

  previousStatus TenantStatus
  newStatus      TenantStatus
  changedBy      String?
  reason         String?      @db.Text
  createdAt      DateTime     @default(now())
  tenantLease    TenantLease  @relation(fields: [tenantLeaseId], references: [id], onDelete: Cascade)
  // @@map("tenant_lease_status_history")

  @@index([tenantLeaseId])
}

// Document management for tenants
model TenantDocument {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  tenantId       String @db.Uuid

  documentType DocumentType
  documentUrl  String

  //document file metadata covered in meta json fields
  // filePath     String
  // fileName     String
  // fileSize     Int?
  // mimeType     String?
  metadata Json?

  // Document metadata
  title       String?
  description String?
  isRequired  Boolean   @default(false)
  isVerified  Boolean   @default(false)
  verifiedAt  DateTime?
  verifiedBy  String?   @db.Uuid

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  uploadedBy String?  @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // @@map("tenant_documents")

  @@index([organizationId])
  @@index([tenantId])
  @@index([documentType])
}

// Background check status history
model BackgroundCheckStatusHistory {
  id             String                @id @default(uuid()) @db.Uuid
  tenantId       String                @db.Uuid
  previousStatus BackgroundCheckStatus
  newStatus      BackgroundCheckStatus
  changedBy      String?
  reason         String?               @db.Text
  createdAt      DateTime              @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // @@map("background_check_status_history")

  @@index([tenantId])
}

// Flexible screening questions and responses system
model ScreeningQuestion {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid

  // Question definition
  question     String
  questionType QuestionType
  isRequired   Boolean      @default(true)
  isActive     Boolean      @default(true)
  sortOrder    Int          @default(0)

  // Question configuration
  options     String[] // For multiple choice, dropdown, checkbox
  placeholder String? // For text inputs
  helpText    String? // Additional guidance for applicants

  // Validation rules
  minLength Int?
  maxLength Int?
  minValue  Decimal? @db.Decimal(12, 2)
  maxValue  Decimal? @db.Decimal(12, 2)
  pattern   String? // Regex pattern for validation

  // Categorization
  category QuestionCategory @default(GENERAL)
  tags     String[] // For filtering and grouping

  // Scoring (for automated screening)
  hasScoring   Boolean @default(false)
  scoringRules Json? // JSON object with scoring logic

  // Usage tracking
  usageCount Int @default(0)

  // Responses to this question
  responses ScreeningResponse[]

  // Audit fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid

  @@index([organizationId])
  @@index([category])
  @@index([isActive])
  @@index([sortOrder])
  // @@map("screening_questions")
}

// Screening responses from applicants
model ScreeningResponse {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  applicationId  String @db.Uuid
  questionId     String @db.Uuid

  // Response data
  textResponse    String?
  numericResponse Decimal?  @db.Decimal(12, 2)
  booleanResponse Boolean?
  dateResponse    DateTime?
  jsonResponse    Json? // For complex responses

  // Scoring and evaluation
  calculatedScore Decimal? @db.Decimal(5, 2)
  flagged         Boolean  @default(false)
  flagReason      String?

  // Verification
  requiresVerification Boolean   @default(false)
  verified             Boolean   @default(false)
  verifiedAt           DateTime?
  verifiedBy           String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application RentalApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  question    ScreeningQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([applicationId, questionId])
  @@index([organizationId])
  @@index([applicationId])
  @@index([questionId])
  @@index([flagged])
  // @@map("screening_responses")
}

// Pre-defined screening question templates for quick setup
model ScreeningQuestionTemplate {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String? @db.Uuid // null for system-wide templates

  name             String
  description      String?
  category         QuestionCategory
  isSystemTemplate Boolean          @default(false) // System vs custom templates

  // Template configuration
  questions Json // Array of question configurations

  // Usage tracking
  usageCount Int      @default(0)
  rating     Decimal? @db.Decimal(3, 2) // User rating 1-5

  // Audit fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.Uuid

  @@index([organizationId])
  @@index([category])
  @@index([isSystemTemplate])
  // @@map("screening_question_templates")
}

// Listing-specific screening configuration
model ListingScreeningConfig {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  listingId      String @db.Uuid // Reference to Listing Service

  // Screening settings
  isScreeningEnabled   Boolean @default(true)
  autoScreenEnabled    Boolean @default(false)
  manualReviewRequired Boolean @default(true)

  // Scoring configuration
  passingScore     Decimal? @db.Decimal(5, 2)
  weightByCategory Json? // Category-based scoring weights

  // Question assignments
  questionIds String[] @db.Uuid // Array of screening question IDs

  // Customization per listing
  customInstructions     String?
  additionalRequirements String?

  // Notification settings
  notifyOnApplication Boolean  @default(true)
  notifyOnAutoReject  Boolean  @default(true)
  notificationEmails  String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid

  @@unique([listingId])
  @@index([organizationId])
  @@index([listingId])
  // @@map("listing_screening_configs")
}

enum TenantType {
  INDIVIDUAL
  COUPLE
  FAMILY
  ROOMMATES
  CORPORATE
}

enum TenantStatus {
  ACTIVE
  INACTIVE
  PROSPECTIVE
  FORMER
  BLACKLISTED
}

enum EmploymentStatus {
  EMPLOYED_FULL_TIME
  EMPLOYED_PART_TIME
  SELF_EMPLOYED
  UNEMPLOYED
  RETIRED
  STUDENT
  CONTRACTOR
}

enum ContactMethod {
  EMAIL
  PHONE
  SMS
  MAIL
}

enum BackgroundCheckStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  NOT_REQUIRED
}

enum ReferenceType {
  PERSONAL
  PROFESSIONAL
  PREVIOUS_LANDLORD
  EMPLOYER
  CHARACTER
}

enum ReferenceRecommendation {
  HIGHLY_RECOMMENDED
  RECOMMENDED
  NEUTRAL
  NOT_RECOMMENDED
  STRONGLY_NOT_RECOMMENDED
}

enum ApplicationStatus {
  DRAFT
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  WITHDRAWN
  EXPIRED
}

enum TenantLeaseStatus {
  ACTIVE
  TERMINATED
  EXPIRED
  PENDING
}

enum DocumentType {
  ID_DOCUMENT
  INCOME_VERIFICATION
  EMPLOYMENT_LETTER
  BANK_STATEMENT
  REFERENCE_LETTER
  BACKGROUND_CHECK
  CREDIT_REPORT
  INSURANCE_CERTIFICATE
  PET_DOCUMENTATION
  OTHER
}

enum QuestionCategory {
  GENERAL // - General application questions
  PERSONAL_INFO //- Contact info, demographics
  EMPLOYMENT //- Job history, employer details
  INCOME //- Salary, income verification
  RENTAL_HISTORY //- Previous rentals, references
  REFERENCES // - Personal/professional references
  PETS //- Pet ownership and details
  VEHICLES //- Vehicle info for parking
  BACKGROUND //- Criminal history, credit checks
  PREFERENCES // - Tenant preferences
  EMERGENCY_CONTACT //- Emergency contact info
  FAMILY // - Family members, dependents
  FINANCIAL // - Banking, credit, debts
  LEGAL //- Legal disclosures, agreements
  CUSTOM //- Custom categories
}

enum QuestionType {
  TEXT
  TEXTAREA
  NUMBER
  BOOLEAN
  DATE
  EMAIL
  PHONE
  SINGLE_SELECT
  MULTI_SELECT
  CHECKBOX
  DROPDOWN
  FILE_UPLOAD
  CURRENCY
  PERCENTAGE
  URL
  TIME
  DATETIME
  RATING
  SLIDER
  SIGNATURE
}
